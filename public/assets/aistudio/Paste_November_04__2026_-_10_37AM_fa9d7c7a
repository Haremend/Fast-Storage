  <symbol id="camera" viewBox="0 0 64 64"><path d="M22 10h20l5 7h9a5 5 0 0 1 5 5v29a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V22a5 5 0 0 1 5-5h9l5-7Z"/><circle cx="32" cy="36" r="13" fill="#24372b"/><circle cx="32" cy="36" r="8" fill="white"/></symbol>
