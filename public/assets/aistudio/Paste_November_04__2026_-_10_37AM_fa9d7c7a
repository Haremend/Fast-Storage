<section class="demo-section forest-scene" aria-label="深色森林音乐播放器玻璃效果">
  <div class="section-tag">01 / Dark botanical glass</div>
  <div class="fern-wallpaper" aria-hidden="true">
    <svg viewBox="0 0 1400 900" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id="leaf" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#12b83b"/><stop offset=".45" stop-color="#087d28"/><stop offset="1" stop-color="#013b17"/></linearGradient>
        <linearGradient id="stem" x1="0" y1="0" x2="1" y2="0"><stop stop-color="#064219"/><stop offset=".5" stop-color="#42a83e"/><stop offset="1" stop-color="#063719"/></linearGradient>
        <g id="fern" fill="url(#leaf)" stroke="#07511e" stroke-width="1.2">
          <path d="M0 300Q105 160 310 0" fill="none" stroke="url(#stem)" stroke-width="6"/>
          <g>
            <path d="M38 266Q-4 226-52 239Q-31 275 38 266Z"/><path d="M57 247Q21 193-24 195Q-3 237 57 247Z"/>
            <path d="M79 222Q56 164 9 151Q19 203 79 222Z"/><path d="M102 195Q88 133 45 111Q46 164 102 195Z"/>
            <path d="M128 167Q126 105 88 73Q77 126 128 167Z"/><path d="M153 139Q163 80 133 39Q111 91 153 139Z"/>
            <path d="M179 111Q202 55 183 8Q149 56 179 111Z"/><path d="M206 83Q241 33 234 -16Q190 24 206 83Z"/>
            <path d="M48 259Q76 207 122 203Q106 250 48 259Z"/><path d="M76 231Q113 178 161 181Q138 227 76 231Z"/>
            <path d="M104 202Q150 151 194 160Q164 204 104 202Z"/><path d="M132 174Q184 129 224 145Q187 183 132 174Z"/>
            <path d="M160 145Q217 108 251 130Q207 159 160 145Z"/><path d="M187 116Q248 87 276 115Q228 135 187 116Z"/>
