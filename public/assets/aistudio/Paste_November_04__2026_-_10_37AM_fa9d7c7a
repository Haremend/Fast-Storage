<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>
(() => {
  const $ = (selector) => document.querySelector(selector);
  const toast = (message) => {
    const node = $('#toast');
    node.textContent = message;
    node.classList.add('show');
    clearTimeout(toast.timer);
    toast.timer = setTimeout(() => node.classList.remove('show'), 1800);
  };
  const tracks = [
    { title: 'Luminescent Dreams', artist: 'FKA twigs', duration: 225 },
    { title: 'Cellophane', artist: 'FKA twigs', duration: 263 },
    { title: 'Two Weeks', artist: 'FKA twigs', duration: 251 }
  ];
  let trackIndex = 0, playing = true, elapsed = 109;
  const progress = $('#progress');
  const fmt = (seconds) => `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
  function renderPlayer() {
    const track = tracks[trackIndex];
    $('#forest-title').textContent = track.title;
    $('#forest-artist').textContent = track.artist;
    $('#elapsed').textContent = fmt(elapsed);
    $('#remaining').textContent = `-${fmt(Math.max(0, track.duration - elapsed))}`;
    progress.max = track.duration;
    progress.value = elapsed;
    const icon = $('#forest-play use');
    icon.setAttribute('href', playing ? '#pause' : '#play');
    $('#forest-play').setAttribute('aria-label', playing ? '暂停' : '播放');
    $('#wave').classList.toggle('paused', !playing);
  }
  function changeTrack(direction) { trackIndex = (trackIndex + direction + tracks.length) % tracks.length; elapsed = 0; renderPlayer(); }
  $('#forest-play').addEventListener('click', () => { playing = !playing; renderPlayer(); });
  $('#previous').addEventListener('click', () => changeTrack(-1));
  $('#next').addEventListener('click', () => changeTrack(1));
  progress.addEventListener('input', () => { elapsed = Number(progress.value); renderPlayer(); });
  $('#favorite').addEventListener('click', (event) => {
    const button = event.currentTarget;
    button.style.color = button.dataset.saved === 'true' ? '#fff' : '#ff6b83';
    button.dataset.saved = button.dataset.saved === 'true' ? 'false' : 'true';
    toast(button.dataset.saved === 'true' ? '已添加到收藏' : '已取消收藏');
  });
  $('#audio-output').addEventListener('click', () => toast('音频输出设备'));
  document.querySelectorAll('[data-toast]').forEach(button => button.addEventListener('click', () => toast(button.dataset.toast)));
  setInterval(() => {
    if (!playing) return;
    elapsed = elapsed >= tracks[trackIndex].duration ? 0 : elapsed + 1;
    renderPlayer();
  }, 1000);

  const miniTracks = [
    { title: 'Reverie', artist: 'Nujabes' },
    { title: 'Aruarian Dance', artist: 'Nujabes' },
    { title: 'Feather', artist: 'Nujabes' }
  ];
  let miniIndex = 0, miniPlaying = false;
  function renderMini() {
    $('#mini-title').textContent = miniTracks[miniIndex].title;
    $('#mini-artist').textContent = miniTracks[miniIndex].artist;
    $('#mini-play use').setAttribute('href', miniPlaying ? '#pause' : '#play');
    $('#mini-play').setAttribute('aria-label', miniPlaying ? '暂停' : '播放');
  }
  $('#mini-play').addEventListener('click', () => { miniPlaying = !miniPlaying; renderMini(); });
  $('#mini-next').addEventListener('click', () => { miniIndex = (miniIndex + 1) % miniTracks.length; renderMini(); });
  document.querySelectorAll('.tab').forEach(tab => tab.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach(item => item.classList.toggle('active', item === tab));
    toast(`已切换到 ${tab.dataset.tab}`);
  }));
  $('#search-toggle').addEventListener('click', () => {
    const panel = $('#search-panel');
    panel.classList.toggle('open');
    if (panel.classList.contains('open')) panel.querySelector('input').focus();
  });
  renderPlayer();
  renderMini();
})();
</script>
</body>
