  <symbol id="library" viewBox="0 0 64 64"><path d="M14 9h36v7H14zM11 20h42v7H11zM10 32a5 5 0 0 1 5-5h34a5 5 0 0 1 5 5v25a5 5 0 0 1-5 5H15a5 5 0 0 1-5-5V32Z"/><path d="m28 35 15 9-15 9V35Z" fill="#eee"/></symbol>
