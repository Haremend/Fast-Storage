    <div class="music-ui">
      <article class="mini-player">
        <div class="album-art" aria-label="专辑封面"></div>
        <div class="mini-meta"><div class="mini-title" id="mini-title">Reverie</div><div class="mini-artist" id="mini-artist">Nujabes</div></div>
        <div class="mini-controls">
          <button id="mini-play" class="mini-play" aria-label="播放"><svg viewBox="0 0 64 64"><use href="#play"/></svg></button>
