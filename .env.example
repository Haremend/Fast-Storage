# ==============================================================================
# SINGLE-USER AUTHENTICATION (单用户管理员凭据)
# Configure your unique username and password on Vercel or in local .env.local.
# Default fallback when not configured: admin / admin123456
# ==============================================================================
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_admin_password_here"

# Optional Gemini API Key for server-side generative enhancements
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host application URL (automatically provided on Vercel as VERCEL_URL)
APP_URL="http://localhost:3000"

# ==============================================================================
# UPSTASH SUITE CONFIGURATION (Serverless Suite)
# If credentials are not provided, UpCloud Vault operates in Hybrid Mock Mode,
# offering instant local preview with fully functional simulated storage,
# vector search, asynchronous queue processing, and Redis caching.
# ==============================================================================

# Upstash Blob: Object storage for avatars and document files (https://console.upstash.com/blob)
UPSTASH_BLOB_TOKEN="your_upstash_blob_token_here"

# Upstash Redis: Global low-latency caching and user session state (https://console.upstash.com/redis)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token_here"

# Upstash Vector: Semantic document embedding, retrieval & recommendations (https://console.upstash.com/vector)
UPSTASH_VECTOR_REST_URL="https://your-vector-index.upstash.io"
UPSTASH_VECTOR_REST_TOKEN="your_upstash_vector_token_here"

# Upstash QStash: Serverless asynchronous task queue & background webhooks (https://console.upstash.com/qstash)
QSTASH_TOKEN="your_qstash_token_here"
QSTASH_CURRENT_SIGNING_KEY="your_qstash_current_signing_key_here"
QSTASH_NEXT_SIGNING_KEY="your_qstash_next_signing_key_here"
